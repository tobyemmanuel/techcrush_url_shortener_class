# ---------- Server ----------
NODE_ENV=development
PORT=3000
# Public address of this API. Short links are built from it, for example http://localhost:3000/aB3xK9z
BASE_URL=http://localhost:3000
# Where your frontend runs. Password reset emails link here.
CLIENT_URL=http://localhost:5173
# Comma separated list of frontend origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:5173
# Set to 1 when the API sits behind one reverse proxy such as Nginx.
TRUST_PROXY=0

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_shortener
DB_SSL=false
DB_LOGGING=false

# ---------- Auth ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=token
# lax works when the frontend and API share a site. Use none (plus HTTPS) for different sites.
COOKIE_SAMESITE=lax
# Defaults to true in production and false otherwise.
# COOKIE_SECURE=true
BCRYPT_ROUNDS=12
# When true, users must click the link in their email before they can log in.
REQUIRE_EMAIL_VERIFICATION=true

# ---------- Cache ----------
CACHE_TTL_SECONDS=300
CACHE_NEGATIVE_TTL_SECONDS=30
CACHE_MAX_ITEMS=5000

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# ---------- Email ----------
# Leave SMTP_HOST empty in development. Emails are then printed in the terminal and in logs/combined.log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Short Links <no-reply@example.com>"

# ---------- Logging ----------
# error | warn | info | http | debug
LOG_LEVEL=debug

# ---------- Seed script (npm run seed) ----------
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
